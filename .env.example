# ---------------------------------------------------------------------------
# Variables de entorno (copia a .env.local para desarrollo; en Netlify se
# configuran en Project configuration > Environment variables).
# ---------------------------------------------------------------------------

# --- Base de datos ---------------------------------------------------------
# Netlify Database (Postgres) inyecta NETLIFY_DB_URL solo: en producción y en
# `netlify dev`. No hay que configurarla a mano.

# --- Modo demo -------------------------------------------------------------
# true = muestra el aviso "Demo · datos ficticios" y bloquea la indexación.
NEXT_PUBLIC_DEMO_MODE=
# URL pública del despliegue (canónicas, Open Graph, enlaces a Telegram/WhatsApp).
NEXT_PUBLIC_SITE_URL=

# --- 1. Panel de administración (/admin) -----------------------------------
# OBLIGATORIA para usar /admin: sin ella el panel queda desactivado (no hay
# contraseña por defecto). Usa una clave larga y aleatoria.
ADMIN_PASSWORD=

# --- 2. Publicación automática en Telegram (Bot API oficial, gratis) ---------
# 1. Habla con @BotFather en Telegram -> /newbot -> copia el token.
# 2. Añade el bot como administrador del grupo/canal.
# 3. Pon el ID del grupo/canal (ej. -1001234567890 o @MasterCollections).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 3. Publicación automática en WhatsApp (opcional) ------------------------
# Sin estas variables, /admin genera el mensaje formateado y un enlace wa.me.
WHATSAPP_WEBHOOK_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_GROUP_ID=

# --- 4. Captura de leads del ebook (Brevo) ----------------------------------
BREVO_API_KEY=
BREVO_LIST_ID=
